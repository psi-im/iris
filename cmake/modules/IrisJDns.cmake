include_guard(GLOBAL)

# The source revision and API baseline share the same authority as CI.
set(_iris_jdns_lock_file "${CMAKE_CURRENT_LIST_DIR}/../../dependencies.lock.json")
get_filename_component(_iris_jdns_source_root "${_iris_jdns_lock_file}" DIRECTORY)
get_filename_component(_iris_jdns_local_source "${_iris_jdns_source_root}/3rdparty/jdns" ABSOLUTE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_iris_jdns_lock_file}")
file(READ "${_iris_jdns_lock_file}" _iris_jdns_lock)
string(REGEX MATCH "\"jdns\"[ \t\r\n]*:[ \t\r\n]*\\{[^}]*\\}" _iris_jdns_entry "${_iris_jdns_lock}")
string(REGEX MATCH "\"commit\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-f]+)\"" _iris_jdns_match "${_iris_jdns_entry}")
set(_iris_jdns_commit "${CMAKE_MATCH_1}")
string(LENGTH "${_iris_jdns_commit}" _iris_jdns_commit_length)
if(NOT _iris_jdns_commit_length EQUAL 40)
    message(FATAL_ERROR "dependencies.lock.json: JDNS commit must be a full lowercase Git SHA")
endif()
string(REGEX MATCH "\"minimum_version\"[ \t\r\n]*:[ \t\r\n]*\"([^\"]*)\""
    _iris_jdns_min_match "${_iris_jdns_entry}")
set(IRIS_JDNS_MIN_VERSION "${CMAKE_MATCH_1}")
if(NOT IRIS_JDNS_MIN_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "dependencies.lock.json: JDNS minimum_version must be a numeric X.Y.Z string")
endif()

# Dependency revisions belong only to the lock. Retire legacy cache entries so
# old build directories cannot retain a different revision after a lock update.
unset(IRIS_JDNS_GIT_TAG CACHE)
unset(IRIS_JDNS_LOCK_DEFAULT CACHE)
if(ANDROID)
    set(_iris_system_jdns_default OFF)
else()
    set(_iris_system_jdns_default AUTO)
endif()
set(IRIS_SYSTEM_JDNS ${_iris_system_jdns_default} CACHE STRING "System QJDns: AUTO, ON or OFF")
unset(_iris_system_jdns_default)
set_property(CACHE IRIS_SYSTEM_JDNS PROPERTY STRINGS AUTO ON OFF)
string(TOUPPER "${IRIS_SYSTEM_JDNS}" _iris_system_jdns)
if(NOT _iris_system_jdns MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "IRIS_SYSTEM_JDNS must be AUTO, ON or OFF")
endif()

function(iris_check_jdns_qt)
    get_target_property(_jdns_qt QJDns::QJDns INTERFACE_QJDNS_QT_MAJOR_VERSION)
    if(NOT _jdns_qt)
        message(FATAL_ERROR
            "QJDns::QJDns does not declare its Qt major version. Use the locked JDNS revision "
            "or a compatible QJDns package. If FETCHCONTENT_SOURCE_DIR_IRIS_JDNS selects a local "
            "checkout, ensure it provides the Qt metadata required by this Iris version.")
    endif()
    if(NOT "${_jdns_qt}" STREQUAL "${QT_DEFAULT_MAJOR_VERSION}")
        message(FATAL_ERROR "QJDns must be built for Qt ${QT_DEFAULT_MAJOR_VERSION}; found Qt ${_jdns_qt}")
    endif()
endfunction()

# A standalone JDNS C library does not satisfy Iris: the installed package
# must also export the QJDns Qt wrapper and its CMake target.
function(iris_jdns_find_failure out)
    if(QJDns_FOUND)
        set(_reason "QJDns was found but does not export QJDns::QJDns")
    elseif(QJDns_NOT_FOUND_MESSAGE)
        set(_reason "${QJDns_NOT_FOUND_MESSAGE}")
    elseif(QJDns_CONSIDERED_CONFIGS)
        set(_candidates "")
        list(LENGTH QJDns_CONSIDERED_CONFIGS _count)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            list(GET QJDns_CONSIDERED_CONFIGS ${_index} _config)
            list(GET QJDns_CONSIDERED_VERSIONS ${_index} _version)
            if(_version)
                list(APPEND _candidates "${_config} (version ${_version})")
            else()
                list(APPEND _candidates "${_config} (version unknown)")
            endif()
        endforeach()
        list(JOIN _candidates ", " _details)
        set(_reason "no compatible QJDns CMake config; considered ${_details}")
    else()
        set(_reason "QJDnsConfig.cmake was not found in the CMake search paths")
    endif()
    set(${out} "${_reason}" PARENT_SCOPE)
endfunction()

function(iris_configure_jdns)
    if(TARGET QJDns::QJDns)
        iris_check_jdns_qt()
        return()
    endif()

    if(NOT _iris_system_jdns STREQUAL "OFF")
        find_package(QJDns ${IRIS_JDNS_MIN_VERSION} QUIET CONFIG)
        if(QJDns_FOUND AND TARGET QJDns::QJDns)
            iris_check_jdns_qt()
            message(STATUS "JDNS: using system QJDns ${QJDns_VERSION} (Qt ${QT_DEFAULT_MAJOR_VERSION} wrapper)")
            return()
        endif()
        iris_jdns_find_failure(_jdns_reason)
        if(_iris_system_jdns STREQUAL "ON")
            message(FATAL_ERROR
                "System QJDns >= ${IRIS_JDNS_MIN_VERSION} with a Qt ${QT_DEFAULT_MAJOR_VERSION} wrapper is required: "
                "${_jdns_reason}. Ensure the QJDns development/CMake package is installed, "
                "or set QJDns_DIR to the directory containing QJDnsConfig.cmake.")
        endif()
        message(STATUS "JDNS: no usable system QJDns >= ${IRIS_JDNS_MIN_VERSION} "
            "(Qt ${QT_DEFAULT_MAJOR_VERSION} wrapper): ${_jdns_reason}")
    endif()

    include(FetchContent)
    if(NOT DEFINED FETCHCONTENT_SOURCE_DIR_IRIS_JDNS
       AND EXISTS "${_iris_jdns_local_source}/CMakeLists.txt")
        set(FETCHCONTENT_SOURCE_DIR_IRIS_JDNS "${_iris_jdns_local_source}")
        message(STATUS "JDNS: using local sources at ${FETCHCONTENT_SOURCE_DIR_IRIS_JDNS}")
    endif()
    set(_jdns_source "JDNS ${IRIS_JDNS_MIN_VERSION} (commit ${_iris_jdns_commit})")
    message(STATUS "JDNS: using bundled ${_jdns_source}; QJDns linked to Qt ${QT_DEFAULT_MAJOR_VERSION}")
    # Keep the bundled dependency static/PIC and its install rules private.
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_QJDNS ON)
    set(BUILD_JDNS_TOOL OFF)
    set(JDNS_ENABLE_INSTALL OFF)
    set(JDNS_BUILD_TESTS OFF)
    set(JDNS_QT_MAJOR_VERSION ${QT_DEFAULT_MAJOR_VERSION}
        CACHE STRING "Qt major version used by QJDns (5 or 6)" FORCE)
    set(MULTI_QT OFF)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    FetchContent_Declare(iris_jdns
        GIT_REPOSITORY https://github.com/psi-im/jdns.git
        GIT_TAG "${_iris_jdns_commit}")
    FetchContent_MakeAvailable(iris_jdns)
    if(NOT TARGET QJDns::QJDns)
        message(FATAL_ERROR "Iris requires the QJDns::QJDns target")
    endif()
    iris_check_jdns_qt()
endfunction()
